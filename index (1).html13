devLoginBtn.addEventListener('click', async ()=>{
  const key = devKeyInput.value.trim();
  if(!key) return;
  const backendUrl = await resolveBackendUrl();
  if(backendUrl === null){
    devLoginError.textContent = 'לא נמצא שרת מחובר — פאנל המפתח דורש את ה-backend.';
    return;
  }
  try{
    const res = await fetch(`${backendUrl}/api/admin/stats`, {
      headers: { 'X-Access-Key': key }
    });
    if(res.status === 401){
      devLoginError.textContent = 'קוד גישה שגוי.';
      return;
    }
    if(res.status === 503){
      devLoginError.textContent = 'פאנל המפתח לא הוגדר עדיין בשרת.';
      return;
    }
    const stats = await res.json();
    devLoginError.textContent = '';
    devLoginPane.style.display = 'none';
    devStatsPane.style.display = 'block';
    devStatsPane.innerHTML = `
      <div class="card">
        <h4><span class="dot"></span>מאגר מוצרים</h4>
        <p>מוצרים שהוזנו ע"י ספקים: <strong>${stats.counts.store_products}</strong></p>
        <p>מוצרים מהמאגר הישראלי (סקרייפינג): <strong>${stats.counts.chain_products}</strong></p>
        <p class="small">גודל קובץ ה-DB: ${(stats.db_size_bytes/1024).toFixed(1)} KB</p>
      </div>
      <div class="card">
        <h4><span class="dot"></span>שירותים פעילים</h4>
        <p>Google Vision OCR: ${stats.vision_ocr_enabled ? '✓ פעיל' : '✗ לא מוגדר (נופל ל-OCR.space)'}</p>
        <p>Spoonacular: ${stats.spoonacular_enabled ? '✓ פעיל' : '✗ לא מוגדר'}</p>
      </div>`;
  }catch(e){
    devLoginError.textContent = 'הייתה בעיה בהתחברות. נסה שוב.';
  }
});
