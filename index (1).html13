/* ---------- profile ---------- */
function updatePillText(){
  const bits = [...profile.diet, ...profile.goals, ...profile.allergies];
  profilePill.textContent = bits.length ? ('הפרופיל שלי: ' + bits.slice(0,2).join(', ') + (bits.length>2?'...':'')) + ' ⚙' : 'הגדר פרופיל ⚙';
}

async function loadProfile(){
  try{
    const res = await window.storage.get('profile', false);
    if(res && res.value){
      profile = JSON.parse(res.value);
      if(!profile.language) profile.language = 'עברית';
    } else {
      openOnboarding();
    }
  }catch(e){
    openOnboarding();
  }
  updatePillText();
}

let pendingOnboarding = false;

async function getSetting(key){
  try{
    const res = await window.storage.get(key, false);
    return res && res.value ? res.value : null;
  }catch(e){ return null; }
}
async function setSetting(key, value){
  try{ await window.storage.set(key, value, false); }catch(e){ /* best effort */ }
}

// Resolves which backend to use, in order:
//   1. An explicit URL the user pasted into the profile sheet.
//   2. A same-origin backend (this page being served BY the FastAPI app itself,
//      the unified deployment) — detected once via a quick /health probe.
//   3. null — no backend, fall back to direct client-side calls.
// '' (empty string) means "use relative /api/... paths on the current origin".
let _cachedBackendUrl; // undefined = not resolved yet
async function resolveBackendUrl(){
  if(_cachedBackendUrl !== undefined) return _cachedBackendUrl;
  const explicit = await getSetting('backend_url');
  if(explicit){ _cachedBackendUrl = explicit; return _cachedBackendUrl; }
  try{
    const res = await withTimeout(fetch('/health'), 1500);
    if(res.ok){ _cachedBackendUrl = ''; return _cachedBackendUrl; }
  }catch(e){ /* no same-origin backend */ }
  _cachedBackendUrl = null;
  return _cachedBackendUrl;
}

async function openOnboarding(){
  document.querySelectorAll('.chip').forEach(chip=>{
    const group = chip.parentElement.dataset.group;
    chip.classList.toggle('selected', profile[group] && profile[group].includes(chip.dataset.val));
  });
  document.querySelectorAll('#languageGroup .chip2').forEach(chip=>{
    chip.classList.toggle('selected', chip.dataset.lang === (profile.language || 'עברית'));
  });
  document.getElementById('ocrKeyInput').value = (await getSetting('ocrspace_key')) || '';
  document.getElementById('spoonacularKeyInput').value = (await getSetting('spoonacular_key')) || '';
  document.getElementById('edamamAppIdInput').value = (await getSetting('edamam_app_id')) || '';
  document.getElementById('edamamAppKeyInput').value = (await getSetting('edamam_app_key')) || '';
  document.getElementById('backendUrlInput').value = (await getSetting('backend_url')) || '';
  const landingVisible = document.getElementById('landingScreen').style.display !== 'none';
  if(landingVisible){
    pendingOnboarding = true;
    return;
  }
  openScreen(onboardOverlay);
}

document.querySelectorAll('#languageGroup .chip2').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('#languageGroup .chip2').forEach(c=>c.classList.remove('selected'));
    chip.classList.add('selected');
    profile.language = chip.dataset.lang;
  });
});

document.querySelectorAll('.chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    const group = chip.parentElement.dataset.group;
    const val = chip.dataset.val;
    if(!profile[group]) profile[group] = [];
    const idx = profile[group].indexOf(val);
    if(idx>-1){ profile[group].splice(idx,1); chip.classList.remove('selected'); }
    else { profile[group].push(val); chip.classList.add('selected'); }
  });
});

document.getElementById('backFromOnboardBtn').addEventListener('click', ()=> closeScreen(onboardOverlay));

document.getElementById('saveProfileBtn').addEventListener('click', async ()=>{
  try{
    await window.storage.set('profile', JSON.stringify(profile), false);
  }catch(e){ /* continue even if save fails */ }
  await setSetting('ocrspace_key', document.getElementById('ocrKeyInput').value.trim());
  await setSetting('spoonacular_key', document.getElementById('spoonacularKeyInput').value.trim());
  await setSetting('edamam_app_id', document.getElementById('edamamAppIdInput').value.trim());
  await setSetting('edamam_app_key', document.getElementById('edamamAppKeyInput').value.trim());
  await setSetting('backend_url', document.getElementById('backendUrlInput').value.trim().replace(/\/$/, ''));
  updatePillText();
  refreshSpoonacularTabVisibility();
  refreshPantryTabVisibility();
  closeScreen(onboardOverlay);
});

profilePill.addEventListener('click', openOnboarding);

/* ---------- compact header menu ---------- */
const menuToggleBtn = document.getElementById('menuToggleBtn');
const menuDropdown = document.getElementById('menuDropdown');
menuToggleBtn.addEventListener('click', (e)=>{
  e.stopPropagation();
  menuDropdown.style.display = menuDropdown.style.display === 'none' ? 'block' : 'none';
});
menuDropdown.querySelectorAll('.menu-item').forEach(item=>{
  item.addEventListener('click', ()=>{ menuDropdown.style.display = 'none'; });
});
document.addEventListener('click', (e)=>{
  if(menuDropdown.style.display !== 'none' && !menuDropdown.contains(e.target) && e.target !== menuToggleBtn){
    menuDropdown.style.display = 'none';
  }
});

/* ---------- recipe book ---------- */
async function loadCookbook(){
  try{
    const res = await window.storage.get('cookbook', false);
    cookbook = (res && res.value) ? JSON.parse(res.value) : [];
  }catch(e){
    cookbook = [];
  }
}

async function persistCookbook(){
  try{ await window.storage.set('cookbook', JSON.stringify(cookbook), false); }catch(e){}
}

function renderCookbook(){
  if(!cookbook.length){
    cookbookList.innerHTML = `<div class="book-empty">עוד אין כאן מתכונים. סרוק מוצר ולחץ "שמור מתכון לספר שלי" כדי להתחיל.</div>`;
    return;
  }
  cookbookList.innerHTML = cookbook.slice().reverse().map(entry => {
    const rec = entry.recipe || {};
    const ing = (rec.ingredients||[]).map(i=>`<li>${i}</li>`).join('');
    const steps = (rec.steps||[]).map(s=>`<li>${s}</li>`).join('');
    const tags = (entry.dietTags||[]).join(', ');
    return `
      <details class="book-entry">
        <summary>
          <div>
            <div class="book-entry-title">${rec.title || entry.productGuess || 'מתכון'}</div>
            <div class="product-guess">${entry.productGuess || ''}${tags?' · '+tags:''}</div>
          </div>
          <div class="book-entry-date">${entry.date}</div>
        </summary>
        <div class="body">
          <p class="recipe-meta">${rec.time_and_yield || ''}</p>
          <ul class="recipe-list">${ing}</ul>
          <ol class="recipe-steps">${steps}</ol>
          <button class="remove-link" data-id="${entry.id}">הסר מהספר</button>
        </div>
      </details>`;
  }).join('');

  cookbookList.querySelectorAll('.remove-link').forEach(btn=>{
    btn.addEventListener('click', async (e)=>{
      const id = e.target.dataset.id;
      cookbook = cookbook.filter(x => String(x.id) !== String(id));
      await persistCookbook();
      renderCookbook();
    });
  });
}

async function saveRecipeToBook(result, btnEl){
  const entry = {
    id: Date.now(),
    date: new Date().toLocaleDateString('he-IL'),
    productGuess: result.product_guess || '',
    dietTags: profile.diet || [],
    recipe: result.recipe || {}
  };
  cookbook.push(entry);
  await persistCookbook();
  btnEl.textContent = 'נשמר לספר המתכונים ✓';
  btnEl.classList.add('saved');
  btnEl.disabled = true;
}

cookbookPill.addEventListener('click', ()=>{
  renderCookbook();
  openScreen(cookbookOverlay);
});
closeCookbookBtn.addEventListener('click', ()=>{
  closeScreen(cookbookOverlay);
});

/* ---------- community board ---------- */
async function loadCommunity(){
  try{
    const res = await window.storage.get('community_recipes', true);
    community = (res && res.value) ? JSON.parse(res.value) : [];
  }catch(e){
    community = [];
  }
}

async function persistCommunity(){
  try{ await window.storage.set('community_recipes', JSON.stringify(community), true); }catch(e){}
}

function renderCommunityList(){
  const filtered = communityFilterVal === 'הכל'
    ? community
    : community.filter(c => (c.dietTags||[]).includes(communityFilterVal));

  if(!filtered.length){
    communityList.innerHTML = `<div class="book-empty">אין עדיין מתכונים בקטגוריה הזו. היה הראשון לשתף!</div>`;
    return;
  }
  communityList.innerHTML = filtered.slice().reverse().map(entry => {
    const ing = (entry.ingredients||[]).map(i=>`<li>${i}</li>`).join('');
    const steps = (entry.steps||[]).map(s=>`<li>${s}</li>`).join('');
    const count = entry.ratingCount || 0;
    const avg = count ? (entry.ratingSum / count) : 0;
    const starsHtml = [1,2,3,4,5].map(n => `<span class="rate-star${n<=Math.round(avg)?' filled':''}" data-id="${entry.id}" data-val="${n}">★</span>`).join('');
    return `
      <details class="book-entry">
        <summary>
          <div>
            <div class="book-entry-title">${entry.title}</div>
            <div class="product-guess">${(entry.dietTags||[]).join(', ')}</div>
          </div>
          <div class="book-entry-date">${entry.date||''}</div>
        </summary>
        <div class="body">
          <ul class="recipe-list">${ing}</ul>
          <ol class="recipe-steps">${steps}</ol>
          <div class="rating-row">
            <span class="rating-stars">${starsHtml}</span>
            <span class="rating-count">${count ? avg.toFixed(1) + ' (' + count + ' דירוגים)' : 'עדיין אין דירוגים'}</span>
          </div>
        </div>
      </details>`;
  }).join('');

  communityList.querySelectorAll('.rate-star').forEach(star=>{
    star.addEventListener('click', async (e)=>{
      e.preventDefault();
      const id = star.dataset.id;
      const val = Number(star.dataset.val);
      const entry = community.find(c => String(c.id) === String(id));
      if(!entry) return;
      entry.ratingSum = (entry.ratingSum || 0) + val;
      entry.ratingCount = (entry.ratingCount || 0) + 1;
      await persistCommunity();
      renderCommunityList();
    });
  });
}

document.querySelectorAll('#communityFilter .chip2').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('#communityFilter .chip2').forEach(c=>c.classList.remove('selected'));
    chip.classList.add('selected');
    communityFilterVal = chip.dataset.val;
    renderCommunityList();
  });
});

