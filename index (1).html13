        <h5>מחיר (₪)</h5>
        <input type="text" id="storePriceInput" class="text-input" inputmode="decimal" placeholder="0.00">
      </div>
      <div class="group">
        <h5>רשימת רכיבים</h5>
        <textarea id="storeIngredientsInput" class="text-input" rows="4" placeholder="כפי שמופיע על גבי האריזה"></textarea>
      </div>
      <button class="save-btn" id="storeSubmitBtn">הוסף מוצר למאגר</button>
      <p class="small" id="storeSubmitStatus" style="margin-top:8px;"></p>

      <div id="storeRecentList" style="margin-top:20px;"></div>
    </div>
  </div>
</div>

<div class="overlay" id="devOverlay" style="display:none;">
  <div class="sheet">
