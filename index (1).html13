const recipeScanZone = document.getElementById('recipeScanZone');
const recipeImageInput = document.getElementById('recipeImageInput');
const recipeScanStatus = document.getElementById('recipeScanStatus');

recipeScanZone.addEventListener('click', ()=> recipeImageInput.click());
recipeImageInput.addEventListener('change', (e)=>{
  if(e.target.files[0]) handleRecipePhoto(e.target.files[0]);
});

function setRecipeScanStatus(text, showSpinner){
  recipeScanStatus.innerHTML = text
    ? `<div class="status-line">${showSpinner ? '<div class="spinner"></div>' : ''}<span>${text}</span></div>`
    : '';
}

function handleRecipePhoto(file){
  const reader = new FileReader();
  reader.onload = async ()=>{
    const dataUrl = reader.result;
    let rawText = '';
    try{
      rawText = await extractTextFromImage(dataUrl, setRecipeScanStatus);
    }catch(err){
      setRecipeScanStatus('לא הצלחתי לקרוא את התמונה. אפשר למלא את השדות ידנית.', false);
      return;
    }
    if(!rawText || rawText.trim().length < 4){
      setRecipeScanStatus('לא זיהיתי טקסט ברור בתמונה. אפשר למלא את השדות ידנית.', false);
      return;
    }
    setRecipeScanStatus('מארגן את המתכון...', true);
    try{
      const parsed = await parseRecipeTextWithClaude(rawText);
      document.getElementById('shareTitle').value = parsed.title || '';
      document.getElementById('shareIngredients').value = (parsed.ingredients || []).join('\n');
      document.getElementById('shareSteps').value = (parsed.steps || []).join('\n');
      setRecipeScanStatus('מולא אוטומטית מהתמונה — כדאי לבדוק ולתקן לפני הפרסום ✓', false);
    }catch(err){
      setRecipeScanStatus('הזיהוי הצליח אבל הארגון של המתכון נכשל. הטקסט הגולמי: ' + rawText.slice(0, 200) + '...', false);
    }
  };
  reader.readAsDataURL(file);
}

async function parseRecipeTextWithClaude(rawText){
  const systemPrompt = `אתה מארגן טקסט גולמי של מתכון (שהתקבל מ-OCR, וייתכנו בו שגיאות) למבנה מסודר. תענה אך ורק ב-JSON תקני, ללא טקסט נוסף וללא Markdown code fences, במבנה:
{"title":"שם המתכון","ingredients":["רכיב וכמות", "..."],"steps":["שלב הכנה", "..."]}
תקן שגיאות OCR ברורות (למשל תווים מוזרים), אבל אל תמציא רכיבים או שלבים שלא נרמזו בטקסט. אם חסר כותרת, הצע שם קצר וסביר לפי הרכיבים.`;
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-6",
      max_tokens: 1000,
      system: systemPrompt,
      messages: [{ role: "user", content: rawText }]
    })
  });
  const json = await response.json();
  const textOut = (json.content || []).map(b=>b.text||'').join('\n');
  const clean = textOut.replace(/```json|```/g,'').trim();
  return JSON.parse(clean);
}

submitCommunityBtn.addEventListener('click', async ()=>{
  const title = document.getElementById('shareTitle').value.trim();
  const ingRaw = document.getElementById('shareIngredients').value.trim();
  const stepsRaw = document.getElementById('shareSteps').value.trim();
  if(!title || !ingRaw || !stepsRaw){
    setStatus('נא למלא שם, רכיבים ואופן הכנה לפני הפרסום.', false);
    return;
  }
  const entry = {
    id: Date.now(),
    date: new Date().toLocaleDateString('he-IL'),
    title,
    ingredients: ingRaw.split('\n').map(s=>s.trim()).filter(Boolean),
    steps: stepsRaw.split('\n').map(s=>s.trim()).filter(Boolean),
    dietTags: shareSelectedDiet.slice(),
    ratingSum: 0,
    ratingCount: 0
  };
  community.push(entry);
  await persistCommunity();
  await bumpUsage('uploads');
  document.getElementById('shareTitle').value = '';
  document.getElementById('shareIngredients').value = '';
  document.getElementById('shareSteps').value = '';
  shareSelectedDiet = [];
  document.querySelectorAll('#shareForm .chip2').forEach(c=>c.classList.remove('selected'));
  recipeImageInput.value = '';
  setRecipeScanStatus('', false);
  shareForm.style.display = 'none';
  renderCommunityList();
});

communityPill.addEventListener('click', async ()=>{
  await loadCommunity();
  renderCommunityList();
  openScreen(communityOverlay);
});
closeCommunityBtn.addEventListener('click', ()=>{
  closeScreen(communityOverlay);
});

const recipeTabs = [
  { btn: tabCommunityBtn, pane: communityPane },
