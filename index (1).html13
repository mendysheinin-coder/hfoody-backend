async function loadStoreRecent(){
  const backendUrl = await resolveBackendUrl();
  if(backendUrl === null) return;
  try{
    const res = await fetch(`${backendUrl}/api/store/products?limit=10`, {
      headers: { 'X-Access-Key': storeAccessKey }
    });
    if(!res.ok) return;
    const json = await res.json();
    const rows = json.results || [];
    storeRecentList.innerHTML = rows.length
      ? `<h5 style="margin-bottom:8px;">מוצרים אחרונים שנוספו</h5>` + rows.map(r=>`
          <div class="book-entry">
            <div class="book-entry-title">${r.name}</div>
            <div class="product-guess">${r.store_name || ''} · ₪${r.price ?? '—'} · ${r.barcode}</div>
          </div>`).join('')
      : '';
  }catch(e){ /* non-critical */ }
}

const storeImportInput = document.getElementById('storeImportInput');
const storeImportBtn = document.getElementById('storeImportBtn');
const storeImportResults = document.getElementById('storeImportResults');

storeImportBtn.addEventListener('click', searchExistingProductForStore);
storeImportInput.addEventListener('keydown', e=>{ if(e.key === 'Enter') searchExistingProductForStore(); });

async function searchExistingProductForStore(){
  const query = storeImportInput.value.trim();
  if(!query) return;
  storeImportResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש...</span></div>`;
  const isBarcode = /^\d{6,}$/.test(query);
  try{
    let matches = [];
    if(isBarcode){
      const res = await fetch(`https://world.openfoodfacts.org/api/v2/product/${query}.json?fields=product_name,product_name_he,ingredients_text,ingredients_text_he,brands,code`);
      const json = await res.json();
      if(json.status === 1 && json.product) matches = [json.product];
    } else {
      matches = await fetchOffMatchesByName(query);
    }
    if(!matches.length){
      storeImportResults.innerHTML = `<div class="book-empty">לא נמצא מוצר תואם. אפשר למלא את הטופס ידנית.</div>`;
      return;
    }
    storeImportResults.innerHTML = matches.map((p, i) => `
      <div class="alt-product" style="cursor:pointer;" data-idx="${i}">
        <div>
          <div style="font-weight:600;font-size:14px;">${p.product_name_he || p.product_name}</div>
          <div class="alt-brand">${p.brands || ''}</div>
        </div>
      </div>`).join('');
    storeImportResults.querySelectorAll('[data-idx]').forEach(el=>{
      el.addEventListener('click', ()=>{
        const p = matches[Number(el.dataset.idx)];
        if(p.code) document.getElementById('storeBarcodeInput').value = p.code;
        else if(isBarcode) document.getElementById('storeBarcodeInput').value = query;
        document.getElementById('storeProductNameInput').value = p.product_name_he || p.product_name || '';
        document.getElementById('storeIngredientsInput').value = p.ingredients_text_he || p.ingredients_text || '';
        storeImportResults.innerHTML = `<p class="small" style="color:var(--olive);">מולא אוטומטית — אפשר לתקן לפני השמירה.</p>`;
      });
    });
  }catch(e){
    storeImportResults.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. אפשר למלא ידנית.</div>`;
  }
}

storeLoginBtn.addEventListener('click', async ()=>{
  const key = storeKeyInput.value.trim();
  if(!key) return;
  const backendUrl = await resolveBackendUrl();
  if(backendUrl === null){
    storeLoginError.textContent = 'לא נמצא שרת מחובר — גישת ספקים דורשת את ה-backend.';
    return;
  }
  try{
    const res = await fetch(`${backendUrl}/api/store/products?limit=1`, {
      headers: { 'X-Access-Key': key }
    });
    if(res.status === 401){
      storeLoginError.textContent = 'קוד גישה שגוי.';
      return;
    }
    if(res.status === 503){
      storeLoginError.textContent = 'גישת ספקים לא הוגדרה עדיין בשרת.';
      return;
    }
    storeAccessKey = key;
    storeLoginError.textContent = '';
    storeLoginPane.style.display = 'none';
    storeFormPane.style.display = 'block';
    loadStoreRecent();
  }catch(e){
    storeLoginError.textContent = 'הייתה בעיה בהתחברות. נסה שוב.';
  }
});

storeSubmitBtn.addEventListener('click', async ()=>{
  const backendUrl = await resolveBackendUrl();
  const barcode = document.getElementById('storeBarcodeInput').value.trim();
  const name = document.getElementById('storeProductNameInput').value.trim();
  const price = document.getElementById('storePriceInput').value.trim();
  const ingredients = document.getElementById('storeIngredientsInput').value.trim();
  const storeName = document.getElementById('storeNameInput').value.trim();
  if(!barcode || !name){
    storeSubmitStatus.textContent = 'נא למלא לפחות ברקוד ושם מוצר.';
    storeSubmitStatus.style.color = 'var(--brick)';
    return;
  }
  const form = new URLSearchParams();
  form.append('barcode', barcode);
  form.append('name', name);
  form.append('price', price || '0');
  form.append('ingredients_text', ingredients);
  form.append('store_name', storeName);
  try{
    const res = await fetch(`${backendUrl}/api/store/products`, {
      method: 'POST',
      headers: { 'X-Access-Key': storeAccessKey },
      body: form
    });
    if(!res.ok) throw new Error('failed');
    storeSubmitStatus.textContent = 'המוצר נוסף בהצלחה ✓';
    storeSubmitStatus.style.color = 'var(--olive)';
    document.getElementById('storeBarcodeInput').value = '';
    document.getElementById('storeProductNameInput').value = '';
    document.getElementById('storePriceInput').value = '';
    document.getElementById('storeIngredientsInput').value = '';
    loadStoreRecent();
  }catch(e){
    storeSubmitStatus.textContent = 'הוספת המוצר נכשלה. נסה שוב.';
    storeSubmitStatus.style.color = 'var(--brick)';
  }
});

