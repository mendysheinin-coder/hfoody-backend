<div class="overlay" id="subscriptionOverlay" style="display:none;">
  <div class="sheet">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
      <h2>המנוי שלי</h2>
      <button class="link-btn" id="closeSubscriptionBtn">→ חזרה</button>
    </div>
    <p class="intro">Hfoody פרימיום — התאמה בלתי מוגבלת, סריקות ומתכונים ללא הגבלה. כל סריקת מוצר וכל מתכון שאתה מפרסם לקהילה מזכים אותך בהנחה קטנה על המנוי החודשי הבא.</p>

    <div class="card" style="margin-top:0;">
      <h4><span class="dot"></span>מחיר המנוי החודשי</h4>
      <p id="subBasePrice" style="font-size:22px;font-weight:700;font-family:'Frank Ruhl Libre',serif;color:var(--herb-dark);"></p>
      <p class="small" id="subFinalPriceLine"></p>
    </div>

    <div class="card">
      <h4><span class="dot"></span>הפעילות שלך</h4>
      <p id="subUsageLine"></p>
      <p class="small">כל סריקה וכל מתכון שהועלה לקהילה = הנחה של 0.1 אגורה (₪0.001) על המנוי הבא. ההנחה מצטברת ולא פוקעת.</p>
    </div>
  </div>
</div>

<script>
/* ---------- screen navigation (turns overlays into real app screens) ---------- */
let navStack = [];
function openScreen(overlayEl){
  overlayEl.style.display = 'flex';
  navStack.push(overlayEl);
  history.pushState({ hfoodyScreen: overlayEl.id }, '');
}
function closeScreen(overlayEl){
  overlayEl.style.display = 'none';
  const idx = navStack.lastIndexOf(overlayEl);
  if(idx > -1) navStack.splice(idx, 1);
  if(history.state && history.state.hfoodyScreen === overlayEl.id){
    history.back();
  }
}
function closeAllScreens(){
  navStack.forEach(el => el.style.display = 'none');
  navStack = [];
}
window.addEventListener('popstate', ()=>{
  // Hardware/browser back was pressed — close whatever's on top without
  // pushing a new entry (this handler itself was triggered by history.back()
  // moving us here, or by the OS back button directly).
  if(navStack.length){
    const top = navStack.pop();
    top.style.display = 'none';
  }
});

let profile = { allergies: [], goals: [], diet: [], language: 'עברית' };
let currentImageDataUrl = null;
let quaggaRunning = false;

const onboardOverlay = document.getElementById('onboardOverlay');
const profilePill = document.getElementById('profilePill');
const scanZone = document.getElementById('scanZone');
const fileInput = document.getElementById('fileInput');
const previewArea = document.getElementById('previewArea');
const statusArea = document.getElementById('statusArea');
const resultArea = document.getElementById('resultArea');
const resetBtn = document.getElementById('resetBtn');

const cookbookPill = document.getElementById('cookbookPill');
const cookbookOverlay = document.getElementById('cookbookOverlay');
const cookbookList = document.getElementById('cookbookList');
const closeCookbookBtn = document.getElementById('closeCookbookBtn');
