async function searchPantryRecipes(){
  const appId = await getSetting('edamam_app_id');
  const appKey = await getSetting('edamam_app_key');
  if(!appId || !appKey){
    pantryResults.innerHTML = `<div class="book-empty">אין מפתחות Edamam שמורים. הוסף אותם בפרופיל ⚙ (חינמי מ-developer.edamam.com).</div>`;
    return;
  }
  const ingredients = pantryIngredientsInput.value.trim();
  if(!ingredients){
    pantryResults.innerHTML = `<div class="book-empty">כתוב לפחות מצרך אחד שיש לך.</div>`;
    return;
  }
  pantryResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש מתכונים...</span></div>`;
  try{
    const query = ingredients.split(',').map(s=>s.trim()).filter(Boolean).join(' ') + (pantryMethod ? ' ' + pantryMethod : '');
    const params = new URLSearchParams({
      type: 'public',
      q: query,
      app_id: appId,
      app_key: appKey
    });
    const res = await fetch(`https://api.edamam.com/api/recipes/v2?${params.toString()}`);
    const json = await res.json();
    const hits = json.hits || [];
    if(!hits.length){
      pantryResults.innerHTML = `<div class="book-empty">לא נמצאו מתכונים עם המצרכים האלה. נסה פחות מצרכים או ניסוח אחר (באנגלית עובד הכי טוב).</div>`;
      return;
    }
    pantryResults.innerHTML = hits.slice(0, 10).map((h, i) => {
      const r = h.recipe;
      return `
        <details class="book-entry" data-pantry-idx="${i}">
          <summary>
            <div>
              <div class="book-entry-title" data-role="title">${r.label}</div>
              <div class="product-guess">${(r.cuisineType||[]).join(', ')}${r.totalTime ? ' · ' + r.totalTime + ' דק\'' : ''}</div>
            </div>
          </summary>
          <div class="body">
            <ul class="recipe-list" data-role="ingredients">${(r.ingredientLines||[]).map(i=>`<li>${i}</li>`).join('')}</ul>
            <p style="margin-top:8px;"><a href="${r.url}" target="_blank" rel="noopener">המתכון המלא באתר המקורי ↗</a></p>
            <button class="save-recipe-btn pantry-translate-btn" data-idx="${i}" style="margin-top:10px;">תרגם לעברית 🇮🇱</button>
          </div>
        </details>`;
    }).join('');

    pantryResults.querySelectorAll('.pantry-translate-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> translatePantryCard(hits, Number(btn.dataset.idx), btn));
    });
  }catch(err){
    pantryResults.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. בדוק את המפתחות שלך ונסה שוב.</div>`;
  }
}

async function translatePantryCard(hits, idx, btn){
  const r = hits[idx].recipe;
  const entryEl = pantryResults.querySelector(`[data-pantry-idx="${idx}"]`);
  if(!entryEl) return;
  const titleEl = entryEl.querySelector('[data-role="title"]');
  const ingEl = entryEl.querySelector('[data-role="ingredients"]');
  btn.textContent = 'מתרגם...';
  btn.disabled = true;
  try{
    const systemPrompt = `תרגם שם מתכון ורשימת רכיבים מאנגלית לעברית טבעית. תענה אך ורק ב-JSON תקני: {"title":"...","ingredients":["...","..."]}`;
    const userPrompt = `שם: ${r.label}\nרכיבים:\n${(r.ingredientLines||[]).join('\n')}`;
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 800,
        system: systemPrompt,
        messages: [{ role: "user", content: userPrompt }]
      })
    });
    const json = await response.json();
    const textOut = (json.content || []).map(b=>b.text||'').join('\n');
    const clean = textOut.replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(clean);
    if(titleEl) titleEl.textContent = parsed.title || r.label;
    if(ingEl) ingEl.innerHTML = (parsed.ingredients||[]).map(i=>`<li>${i}</li>`).join('');
    btn.textContent = 'תורגם ✓';
    btn.classList.add('saved');
  }catch(err){
    btn.textContent = 'שגיאה בתרגום — נסה שוב';
    btn.disabled = false;
  }
}

document.querySelectorAll('#spoonacularDietFilter .chip2').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('#spoonacularDietFilter .chip2').forEach(c=>c.classList.remove('selected'));
    chip.classList.add('selected');
    spoonDietFilter = chip.dataset.spoonDiet;
  });
});

async function searchSpoonacular(){
  const backendUrl = await resolveBackendUrl();
  const key = await getSetting('spoonacular_key');
  if(backendUrl === null && !key){
    spoonResults.innerHTML = `<div class="book-empty">אין מפתח Spoonacular שמור ואין שרת מוגדר. הוסף אחד מהם בפרופיל ⚙.</div>`;
    return;
  }
  spoonResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש...</span></div>`;
  try{
    const q = spoonSearchInput.value.trim();
    let json;
    if(backendUrl !== null){
      const params = new URLSearchParams({ number: '8' });
      if(q) params.set('query', q);
      if(spoonDietFilter) params.set('diet', spoonDietFilter);
      const res = await fetch(`${backendUrl}/api/spoonacular/search?${params.toString()}`);
      if(!res.ok) throw new Error(`backend error (${res.status})`);
      json = await res.json();
    } else {
      const params = new URLSearchParams({
        apiKey: key,
        number: '8',
        addRecipeInformation: 'true',
        fillIngredients: 'true'
      });
      if(q) params.set('query', q);
      if(spoonDietFilter) params.set('diet', spoonDietFilter);
      const res = await fetch(`https://api.spoonacular.com/recipes/complexSearch?${params.toString()}`);
      json = await res.json();
    }
    if(json.status === 'failure' || json.code){
      spoonResults.innerHTML = `<div class="book-empty">שגיאה מ-Spoonacular: ${json.message || 'בדוק את המפתח/השרת שלך'}.</div>`;
      return;
    }
    const results = json.results || [];
    if(!results.length){
      spoonResults.innerHTML = `<div class="book-empty">לא נמצאו מתכונים תואמים.</div>`;
      return;
    }
    spoonResults.innerHTML = results.map(r=>{
      const ingredients = (r.extendedIngredients || []).map(i=>i.original);
      const tags = [r.vegan && 'טבעוני', r.vegetarian && 'צמחוני', r.ketogenic && 'קטוגני', (r.diets||[]).includes('paleo') && 'פליאו'].filter(Boolean).join(', ');
      return `
        <details class="book-entry">
          <summary>
            <div>
              <div class="book-entry-title">${r.title}</div>
              <div class="product-guess">${tags || 'ללא תיוג דיאטה מיוחד'}</div>
            </div>
          </summary>
          <div class="body">
            <ul class="recipe-list">${ingredients.map(i=>`<li>${i}</li>`).join('')}</ul>
            <p style="margin-top:8px;white-space:pre-wrap;">${(r.instructions||'').replace(/<[^>]+>/g,'')}</p>
          </div>
        </details>`;
    }).join('');
  }catch(err){
    spoonResults.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. נסה שוב.</div>`;
  }
}
spoonSearchBtn.addEventListener('click', searchSpoonacular);
spoonSearchInput.addEventListener('keydown', e=>{ if(e.key === 'Enter') searchSpoonacular(); });

/* ---------- Israeli National Nutrition Database (CSV import) ---------- */
israeliCsvInput.addEventListener('change', (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  israeliResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>קורא את הקובץ...</span></div>`;
  Papa.parse(file, {
    header: true,
    skipEmptyLines: true,
    encoding: 'UTF-8',
    complete: (results)=>{
      israeliRecipes = results.data;
      israeliResults.innerHTML = `<div class="book-empty">נטענו ${israeliRecipes.length} שורות מהקובץ. חפש לפי שם מתכון למעלה.</div>`;
    },
    error: ()=>{
      israeliResults.innerHTML = `<div class="book-empty">לא הצלחתי לקרוא את הקובץ. ודא שזה קובץ CSV תקין מ-data.gov.il.</div>`;
    }
  });
});

function guessField(row, candidates){
  const keys = Object.keys(row);
  for(const c of candidates){
    const match = keys.find(k => k.includes(c));
    if(match) return row[match];
  }
  return '';
}

function searchIsraeliRecipes(){
  if(!israeliRecipes.length){
    israeliResults.innerHTML = `<div class="book-empty">קודם צריך להעלות את קובץ המתכונים מ-data.gov.il למעלה.</div>`;
    return;
  }
  const q = israeliSearchInput.value.trim();
  const nameKeys = ['שם', 'מתכון', 'תיאור'];
  const filtered = q
    ? israeliRecipes.filter(row => nameKeys.some(k => Object.keys(row).some(key => key.includes(k) && (row[key]||'').includes(q))))
    : israeliRecipes.slice(0, 20);
  if(!filtered.length){
    israeliResults.innerHTML = `<div class="book-empty">לא נמצאו מתכונים תואמים בקובץ.</div>`;
    return;
  }
  israeliResults.innerHTML = filtered.slice(0, 20).map((row, idx)=>{
    const name = guessField(row, ['שם', 'מתכון']) || `שורה ${idx+1}`;
    const rowText = Object.entries(row).map(([k,v])=> v ? `${k}: ${v}` : null).filter(Boolean).join('\n');
    return `
      <details class="book-entry">
        <summary><div><div class="book-entry-title">${name}</div></div></summary>
        <div class="body"><p style="white-space:pre-wrap;">${rowText}</p></div>
      </details>`;
  }).join('');
}
israeliSearchBtn.addEventListener('click', searchIsraeliRecipes);
israeliSearchInput.addEventListener('keydown', e=>{ if(e.key === 'Enter') searchIsraeliRecipes(); });

/* ---------- real recipe search (TheMealDB) ---------- */
mealSearchBtn.addEventListener('click', ()=> searchMeals(mealSearchInput.value.trim()));
mealSearchInput.addEventListener('keydown', e=>{ if(e.key === 'Enter') searchMeals(mealSearchInput.value.trim()); });

document.querySelectorAll('#searchPane .chip2[data-diet-cat]').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.querySelectorAll('#searchPane .chip2[data-diet-cat]').forEach(c=>c.classList.remove('selected'));
    chip.classList.add('selected');
    const cat = chip.dataset.dietCat;
    if(cat === '__paleo') loadPseudoDietMeals(['chicken','salmon'], 'פליאו (בקירוב, לפי חיפוש מילות מפתח — אין קטגוריה רשמית במאגר)');
    else if(cat === '__keto') loadPseudoDietMeals(['egg','cheese'], 'קטוגני (בקירוב, לפי חיפוש מילות מפתח — אין קטגוריה רשמית במאגר)');
    else loadMealsByCategory(cat);
  });
});

let currentMealsForTranslation = [];

function renderMealCards(meals){
  currentMealsForTranslation = meals;
  if(!meals.length){
    mealResults.innerHTML = `<div class="book-empty">לא נמצאו מתכונים תואמים. נסה מילה אחרת (באנגלית עובד הכי טוב).</div>`;
    return;
  }
  mealResults.innerHTML = meals.slice(0,10).map((m, idx)=>{
    const ingredients = [];
    for(let i=1;i<=20;i++){
      const ing = m['strIngredient'+i];
      const measure = m['strMeasure'+i];
      if(ing && ing.trim()) ingredients.push(`${measure && measure.trim() ? measure.trim()+' ' : ''}${ing.trim()}`);
    }
    return `
      <details class="book-entry" data-meal-idx="${idx}">
        <summary>
          <div>
            <div class="book-entry-title" data-role="title">${m.strMeal}</div>
            <div class="product-guess">${m.strCategory||''}${m.strArea ? ' · '+m.strArea : ''}</div>
          </div>
        </summary>
        <div class="body">
          <ul class="recipe-list" data-role="ingredients">${ingredients.map(i=>`<li>${i}</li>`).join('')}</ul>
          <p data-role="instructions" style="margin-top:8px;white-space:pre-wrap;">${m.strInstructions||''}</p>
          <button class="save-recipe-btn translate-btn" data-idx="${idx}" style="margin-top:10px;">תרגם לעברית 🇮🇱</button>
        </div>
      </details>`;
  }).join('');

  mealResults.querySelectorAll('.translate-btn').forEach(btn=>{
    btn.addEventListener('click', ()=> translateMeal(Number(btn.dataset.idx), btn));
  });

  if(profile.language !== 'English'){
    mealResults.querySelectorAll('.translate-btn').forEach(btn=>{
      translateMeal(Number(btn.dataset.idx), btn);
    });
  }
}

async function translateMeal(idx, btn){
  const meal = currentMealsForTranslation[idx];
  if(!meal) return;
  const entryEl = mealResults.querySelector(`[data-meal-idx="${idx}"]`);
  if(!entryEl) return;
  const titleEl = entryEl.querySelector('[data-role="title"]');
  const ingEl = entryEl.querySelector('[data-role="ingredients"]');
  const instrEl = entryEl.querySelector('[data-role="instructions"]');
  const ingredients = [];
  for(let i=1;i<=20;i++){
    const ing = meal['strIngredient'+i];
    const measure = meal['strMeasure'+i];
    if(ing && ing.trim()) ingredients.push(`${measure && measure.trim() ? measure.trim()+' ' : ''}${ing.trim()}`);
  }
  btn.textContent = 'מתרגם...';
  btn.disabled = true;
  try{
    const systemPrompt = `תרגם מתכון בישול מאנגלית לעברית טבעית ושוטפת, שמור על יחידות מידה וכמויות מדויקות. תענה אך ורק ב-JSON תקני במבנה הבא, ללא שום טקסט נוסף וללא Markdown code fences:
{"title":"שם המתכון בעברית","ingredients":["רכיב מתורגם", "..."],"instructions":"הוראות ההכנה בעברית, כטקסט אחד עם ירידות שורה בין שלבים"}`;
    const userPrompt = `שם: ${meal.strMeal}\nרכיבים:\n${ingredients.join('\n')}\nהוראות הכנה:\n${meal.strInstructions||''}`;
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        system: systemPrompt,
        messages: [{ role: "user", content: userPrompt }]
      })
    });
    const json = await response.json();
    const textOut = (json.content || []).map(b=>b.text||'').join('\n');
    const clean = textOut.replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(clean);
    if(titleEl) titleEl.textContent = parsed.title || meal.strMeal;
    if(ingEl) ingEl.innerHTML = (parsed.ingredients||[]).map(i=>`<li>${i}</li>`).join('');
    if(instrEl) instrEl.textContent = parsed.instructions || meal.strInstructions || '';
    btn.textContent = 'תורגם ✓';
    btn.classList.add('saved');
  }catch(err){
    btn.textContent = 'שגיאה בתרגום — נסה שוב';
    btn.disabled = false;
  }
}

async function searchMeals(q){
  if(!q) return;
  mealResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש...</span></div>`;
  try{
    const res = await fetch(`https://www.themealdb.com/api/json/v1/1/search.php?s=${encodeURIComponent(q)}`);
    const json = await res.json();
    renderMealCards(json.meals || []);
  }catch(err){
    mealResults.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. נסה שוב.</div>`;
  }
}

async function loadMealsByCategory(category){
  mealResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>טוען מתכוני ${category}...</span></div>`;
  try{
    const listRes = await fetch(`https://www.themealdb.com/api/json/v1/1/filter.php?c=${encodeURIComponent(category)}`);
    const listJson = await listRes.json();
    const basics = (listJson.meals || []).slice(0,8);
    if(!basics.length){
      mealResults.innerHTML = `<div class="book-empty">לא נמצאו מתכונים בקטגוריה הזו.</div>`;
      return;
    }
    const fullMeals = await Promise.all(basics.map(async b=>{
      try{
        const r = await fetch(`https://www.themealdb.com/api/json/v1/1/lookup.php?i=${b.idMeal}`);
        const j = await r.json();
        return (j.meals || [])[0];
      }catch(e){ return null; }
    }));
    renderMealCards(fullMeals.filter(Boolean));
  }catch(err){
    mealResults.innerHTML = `<div class="book-empty">הייתה בעיה בטעינת המתכונים. נסה שוב.</div>`;
  }
}

async function loadPseudoDietMeals(terms, label){
  mealResults.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש מתכוני ${label}...</span></div>`;
  try{
    const results = await Promise.all(terms.map(async t=>{
      try{
        const r = await fetch(`https://www.themealdb.com/api/json/v1/1/search.php?s=${encodeURIComponent(t)}`);
        const j = await r.json();
        return j.meals || [];
      }catch(e){ return []; }
    }));
    const seen = new Set();
    const merged = [];
    results.flat().forEach(m=>{
      if(!seen.has(m.idMeal)){ seen.add(m.idMeal); merged.push(m); }
    });
    if(!merged.length){
      mealResults.innerHTML = `<p class="small" style="margin-bottom:10px;">${label}</p><div class="book-empty">לא נמצאו מתכונים מתאימים.</div>`;
      return;
    }
    renderMealCards(merged);
    mealResults.innerHTML = `<p class="small" style="margin-bottom:10px;">${label}</p>` + mealResults.innerHTML;
  }catch(err){
    mealResults.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. נסה שוב.</div>`;
  }
}

/* ---------- image / OCR mode ---------- */
scanZone.addEventListener('click', ()=> fileInput.click());
scanZone.addEventListener('dragover', e=>{e.preventDefault(); scanZone.classList.add('dragover');});
scanZone.addEventListener('dragleave', ()=> scanZone.classList.remove('dragover'));
scanZone.addEventListener('drop', e=>{
  e.preventDefault(); scanZone.classList.remove('dragover');
  if(e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', e=>{
  if(e.target.files[0]) handleFile(e.target.files[0]);
});
resetBtn.addEventListener('click', ()=>{
  clearResults();
  fileInput.value=''; manualBarcode.value='';
  stopCamera();
});

function handleFile(file){
  const reader = new FileReader();
  reader.onload = ()=>{
    currentImageDataUrl = reader.result;
    previewArea.innerHTML = `
      <div class="preview-row">
        <img class="preview-thumb" src="${currentImageDataUrl}">
        <div class="preview-meta">${file.name || 'תמונה'}<br><button class="link-btn" id="rescanBtn">בחר תמונה אחרת</button></div>
      </div>`;
    document.getElementById('rescanBtn').addEventListener('click', ()=> fileInput.click());
    resultArea.innerHTML='';
    resetBtn.style.display='none';
    runOCR(currentImageDataUrl);
  };
  reader.readAsDataURL(file);
}

function setStatus(text, showSpinner){
  statusArea.innerHTML = text ? `<div class="status-line">${showSpinner?'<div class="spinner"></div>':''}<span>${text}</span></div>` : '';
}

function preprocessImage(dataUrl){
  return new Promise((resolve)=>{
    const img = new Image();
    img.onload = ()=>{
      const maxW = 1400;
      const scale = img.width > maxW ? maxW / img.width : 1;
      const w = Math.round(img.width * scale);
      const h = Math.round(img.height * scale);
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      const imageData = ctx.getImageData(0, 0, w, h);
      const d = imageData.data;
      const contrast = 1.35;
      const intercept = 128 * (1 - contrast);
      for(let i=0;i<d.length;i+=4){
        const gray = 0.299*d[i] + 0.587*d[i+1] + 0.114*d[i+2];
        let v = gray * contrast + intercept;
        v = Math.max(0, Math.min(255, v));
        d[i] = d[i+1] = d[i+2] = v;
      }
      ctx.putImageData(imageData, 0, 0);
      resolve(canvas.toDataURL('image/jpeg', 0.92));
    };
    img.onerror = ()=> resolve(dataUrl);
    img.src = dataUrl;
  });
}

document.getElementById('manualEntryBtn').addEventListener('click', ()=>{
  previewArea.innerHTML = '';
  resetBtn.style.display = 'block';
  showOcrReview('');
});

function withTimeout(promise, ms){
  return Promise.race([
    promise,
    new Promise((_, reject)=> setTimeout(()=> reject(new Error('timeout')), ms))
  ]);
}

async function ocrSpaceRecognize(dataUrl){
  const backendUrl = await getSetting('backend_url');
  if(backendUrl){
    const form = new URLSearchParams();
    form.append('image_base64', dataUrl);
    form.append('language', 'heb');
    const res = await fetch(`${backendUrl}/api/ocr`, { method: 'POST', body: form });
    if(!res.ok) throw new Error(`backend OCR error (${res.status})`);
    const json = await res.json();
    if(!json.text || !json.text.trim()) throw new Error('empty backend OCR result');
    return json.text.trim();
  }

  const apiKey = (await getSetting('ocrspace_key')) || 'helloworld';
  const form = new URLSearchParams();
  form.append('apikey', apiKey);
  form.append('base64Image', dataUrl);
  form.append('language', 'heb');
  form.append('OCREngine', '2');
  form.append('scale', 'true');
  form.append('isOverlayRequired', 'false');
  const res = await fetch('https://api.ocr.space/parse/image', { method: 'POST', body: form });
  const json = await res.json();
  if(json.IsErroredOnProcessing){
    throw new Error(Array.isArray(json.ErrorMessage) ? json.ErrorMessage.join(', ') : 'OCR.space error');
  }
  const text = (json.ParsedResults && json.ParsedResults[0] && json.ParsedResults[0].ParsedText) || '';
  if(!text.trim()) throw new Error('empty OCR.space result');
  return text.trim();
}

async function extractTextFromImage(dataUrl, onStatus){
  onStatus && onStatus('משפר את איכות התמונה...', true);
  const cleanedDataUrl = await preprocessImage(dataUrl);

  onStatus && onStatus('קורא את התמונה...', true);
  try{
    const text = await withTimeout(ocrSpaceRecognize(cleanedDataUrl), 20000);
    return text;
  }catch(err){
    // OCR.space failed or timed out (e.g. shared demo key rate-limited) — fall back to local Tesseract
  }

  onStatus && onStatus('קורא את התמונה (מנוע גיבוי מקומי)...', true);
  const recognizePromise = Tesseract.recognize(cleanedDataUrl, 'heb+eng', {
    tessedit_pageseg_mode: 6,
    logger: m=>{
      if(m.status === 'recognizing text'){
        onStatus && onStatus(`קורא את התמונה... ${Math.round(m.progress*100)}%`, true);
      }
    }
  });
  const { data } = await withTimeout(recognizePromise, 25000);
  return (data.text || '').trim();
}

async function runOCR(dataUrl){
  let text = '';
  try{
    text = await extractTextFromImage(dataUrl, setStatus);
  }catch(err){
    text = '';
  }
  setStatus('', false);
  showOcrReview(text);
}

function autoCleanOcrText(raw){
  return raw
    .split('\n')
    .map(line => line.trim())
    // drop lines that are mostly symbols/noise rather than real words
    .filter(line => {
      if(!line) return false;
      const letters = (line.match(/[א-תA-Za-z]/g) || []).length;
      return letters >= Math.max(2, line.length * 0.35);
    })
    // strip stray symbols but keep letters, digits, spaces and common punctuation
    .map(line => line.replace(/[^א-תA-Za-z0-9\s.,%()\/\-]/g, ' ').replace(/\s{2,}/g, ' ').trim())
    .filter(Boolean)
    .join('\n');
}

function showOcrReview(text){
  const hint = text.length < 4
    ? 'לא הצלחתי לקרוא טקסט ברור מהתמונה. אפשר לנסות תמונה קרובה וממוקדת יותר, או פשוט להקליד את הרכיבים כאן בעצמך.'
    : 'בדוק שהטקסט שזוהה נכון, ותקן טעויות אם יש — לפני שממשיכים לניתוח. אם יש הרבה תווים מוזרים, אפשר ללחוץ "נקה טקסט אוטומטית".';
  resultArea.innerHTML = `
    <div class="card">
      <h4><span class="dot"></span>הטקסט שזוהה</h4>
      <p class="small" style="margin-bottom:10px;">${hint}</p>
      <textarea id="ocrReviewText" class="text-input" rows="6">${text}</textarea>
      <button class="save-recipe-btn" id="ocrCleanBtn" style="margin-top:10px;">נקה טקסט אוטומטית</button>
      <button class="save-btn" id="ocrConfirmBtn">המשך לניתוח</button>
    </div>

    <div class="card">
      <h4><span class="dot"></span>לא בטוח שזה מדויק? הצלב מול מאגר</h4>
      <p class="small" style="margin-bottom:10px;">הקלד את שם המוצר כפי שמופיע בכותרת הראשית של האריזה (הרבה יותר קל לקרוא נכון מאשר את רשימת הרכיבים הקטנה) — ננסה למצוא אותו במאגר עם רכיבים מדויקים במקום להסתמך על הטקסט הסרוק.</p>
      <div style="display:flex;gap:8px;">
        <input type="text" id="titleSearchInput" class="text-input" placeholder="לדוגמה: קורנפלקס שוקולד תלמה" style="flex:1;margin:0;">
        <button class="save-recipe-btn" id="titleSearchBtn" style="margin:0;">חפש</button>
      </div>
      <div id="titleSearchResults" style="margin-top:10px;"></div>
    </div>`;

  document.getElementById('ocrCleanBtn').addEventListener('click', ()=>{
    const area = document.getElementById('ocrReviewText');
    area.value = autoCleanOcrText(area.value);
  });
  document.getElementById('ocrConfirmBtn').addEventListener('click', ()=>{
    const finalText = document.getElementById('ocrReviewText').value.trim();
    if(finalText.length < 4){
      setStatus('נא להזין לפחות כמה מילים מרשימת הרכיבים.', false);
      return;
    }
    resultArea.innerHTML = '';
    analyzeWithClaude({ extractedText: finalText });
  });

  const titleSearchInput = document.getElementById('titleSearchInput');
  const titleSearchBtn = document.getElementById('titleSearchBtn');
  const titleSearchResults = document.getElementById('titleSearchResults');
  titleSearchBtn.addEventListener('click', ()=> searchProductByTitle(titleSearchInput.value.trim(), titleSearchResults));
  titleSearchInput.addEventListener('keydown', e=>{ if(e.key === 'Enter') titleSearchBtn.click(); });
}

async function searchProductByTitle(name, container){
  if(!name){ return; }
  container.innerHTML = `<div class="status-line"><div class="spinner"></div><span>מחפש במאגר...</span></div>`;
  try{
    const url = `https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(name)}&search_simple=1&action=process&json=1&page_size=5&fields=product_name,product_name_he,brands,nutriscore_grade,ingredients_text,ingredients_text_he,nutriments,image_front_url,code`;
    const res = await fetch(url);
    const json = await res.json();
    const products = (json.products || []).filter(p => p.product_name || p.product_name_he);
    if(!products.length){
      container.innerHTML = `<div class="book-empty">לא נמצאה התאמה במאגר. אפשר להמשיך עם הטקסט הסרוק למעלה, אחרי שתערוך אותו.</div>`;
      return;
    }
    container.innerHTML = products.map((p, i) => `
      <div class="alt-product" style="cursor:pointer;" data-idx="${i}">
        <div>
          <div style="font-weight:600;font-size:14px;">${p.product_name_he || p.product_name}</div>
          <div class="alt-brand">${p.brands || ''}</div>
        </div>
        <span class="nutriscore ns-${(p.nutriscore_grade||'x').toLowerCase()}">${(p.nutriscore_grade||'?').toUpperCase()}</span>
      </div>`).join('');
    container.querySelectorAll('[data-idx]').forEach(el=>{
      el.addEventListener('click', async ()=>{
        const product = products[Number(el.dataset.idx)];
        const ingredientsText = product.ingredients_text_he || product.ingredients_text || '';
        if(!ingredientsText){
          setStatus('נמצא מוצר תואם, אבל אין לו רשימת רכיבים במאגר. אפשר להמשיך עם הטקסט הסרוק למעלה.', false);
          return;
        }
        resultArea.innerHTML = '';
        renderProductHeader(product);
        setStatus('מחפש חלופות טובות יותר...', true);
        const alternatives = await fetchAlternatives(product);
        await analyzeWithClaude({
          extractedText: buildTextForModel(product, ingredientsText),
          knownAlternatives: alternatives
        });
      });
    });
  }catch(err){
    container.innerHTML = `<div class="book-empty">הייתה בעיה בחיפוש. אפשר להמשיך עם הטקסט הסרוק למעלה.</div>`;
  }
}

/* ---------- barcode mode ---------- */
supportNote.textContent = 'אם המצלמה לא נפתחת, ודא שהאתר נפתח מכתובת https (לא כקובץ מקומי), ואפשר תמיד להקליד את הברקוד ידנית למטה.';

startCamBtn.addEventListener('click', startCamera);
stopCamBtn.addEventListener('click', stopCamera);
manualSearchBtn.addEventListener('click', ()=>{
  const val = manualBarcode.value.trim();
  if(val.length >= 6){
    stopCamera();
    lookupBarcode(val);
  }
});
manualBarcode.addEventListener('keydown', e=>{
  if(e.key === 'Enter') manualSearchBtn.click();
});

function startCamera(){
  if(typeof Quagga === 'undefined'){
    showError('ספריית סריקת הברקוד לא נטענה. אפשר להקליד את הברקוד ידנית למטה.');
    manualBarcode.focus();
    return;
  }
  videoWrap.style.display = 'block';
  startCamBtn.style.display = 'none';
  stopCamBtn.style.display = 'block';

  Quagga.init({
    inputStream: {
      name: 'Live',
      type: 'LiveStream',
      target: videoWrap,
      constraints: { facingMode: 'environment', width: 640, height: 360 }
    },
    locator: { patchSize: 'medium', halfSample: true },
    numOfWorkers: 2,
    decoder: {
      readers: ['ean_reader','ean_8_reader','upc_reader','upc_e_reader','code_128_reader']
    },
    locate: true
  }, function(err){
    if(err){
      stopCamera();
      showError('לא הצלחתי לגשת למצלמה (ייתכן שהאתר צריך להיפתח מכתובת https). אפשר להקליד את הברקוד ידנית למטה.');
      manualBarcode.focus();
      return;
    }
    Quagga.start();
    quaggaRunning = true;
  });

  Quagga.onDetected(onBarcodeDetected);
}

function onBarcodeDetected(result){
  const code = result && result.codeResult && result.codeResult.code;
  if(!code) return;
  stopCamera();
  lookupBarcode(code);
}

function stopCamera(){
  if(quaggaRunning){
    try{ Quagga.offDetected(onBarcodeDetected); Quagga.stop(); }catch(e){}
    quaggaRunning = false;
  }
  videoWrap.style.display = 'none';
  startCamBtn.style.display = 'block';
  stopCamBtn.style.display = 'none';
}

async function lookupIlProductByBarcode(barcode){
  const backendUrl = await resolveBackendUrl();
  if(backendUrl === null) return null;
  try{
    const res = await fetch(`${backendUrl}/api/il-products/search?barcode=${encodeURIComponent(barcode)}`);
    if(!res.ok) return null;
    const json = await res.json();
    return (json.results && json.results[0]) || null;
  }catch(e){
    return null;
  }
}

async function lookupBarcode(barcode){
  clearResults();
  setStatus('מחפש את המוצר במאגר...', true);

  const ilProduct = await lookupIlProductByBarcode(barcode);
  if(ilProduct){
    previewArea.innerHTML = `
      <div class="card product-card">
        <div style="flex:1;">
          <div class="product-name">${ilProduct.name}</div>
          <div class="product-brand">${ilProduct.chain || ''} · ₪${ilProduct.price ?? '—'}${ilProduct.source === 'store' ? ' · דווח ע"י הסופר' : ''}</div>
        </div>
      </div>`;

    // Store-submitted data includes real ingredients — that's more trustworthy
    // than anything we'd guess from an external database, so use it directly.
    if(ilProduct.source === 'store' && ilProduct.ingredients_text){
      setStatus('מחפש חלופות טובות יותר...', true);
      const pseudoProduct = { product_name: ilProduct.name, brands: ilProduct.chain, code: barcode };
      const alternatives = await fetchAlternatives(pseudoProduct);
      await analyzeWithClaude({
        extractedText: `שם מוצר: ${ilProduct.name}\nרשימת רכיבים (כפי שדווח ע"י הסופר):\n${ilProduct.ingredients_text}`,
        knownAlternatives: alternatives
      });
      return;
    }
  }

  try{
    const res = await fetch(`https://world.openfoodfacts.org/api/v2/product/${barcode}.json?fields=product_name,product_name_he,ingredients_text,ingredients_text_he,nutriments,nutriscore_grade,image_front_url,categories_tags,brands,code`);
    const json = await res.json();
    if(json.status !== 1 || !json.product){
      // Not in Open Food Facts by barcode — if the Israeli DB gave us a name, try that instead
      if(ilProduct && ilProduct.name){
        setStatus('לא נמצא לפי ברקוד — מנסה לפי השם מהמאגר הישראלי...', true);
        const matches = await fetchOffMatchesByName(ilProduct.name);
        if(matches.length){
          renderOffNameMatches(matches, `נמצאו התאמות אפשריות ל"${ilProduct.name}":`);
          setStatus('', false);
          return;
        }
      }
      setStatus('', false);
      showError('לא מצאתי את המוצר הזה במאגר Open Food Facts. אפשר לנסות לצלם את רשימת הרכיבים במקום.');
      return;
    }
    const product = json.product;
    const ingredientsText = product.ingredients_text_he || product.ingredients_text || '';
    renderProductHeader(product);

    if(!ingredientsText){
      setStatus('', false);
      showError('המוצר נמצא, אבל אין רשימת רכיבים במאגר עבורו. אפשר לצלם את התווית במקום.');
      return;
    }

    setStatus('מחפש חלופות טובות יותר...', true);
    const alternatives = await fetchAlternatives(product);

    await analyzeWithClaude({
      extractedText: buildTextForModel(product, ingredientsText),
      knownAlternatives: alternatives
    });
  }catch(err){
    setStatus('', false);
    showError('הייתה בעיה בחיפוש המוצר. נסה שוב.');
  }
}

async function fetchOffMatchesByName(name){
  try{
    const url = `https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(name)}&search_simple=1&action=process&json=1&page_size=5&fields=product_name,product_name_he,brands,nutriscore_grade,ingredients_text,ingredients_text_he,nutriments,image_front_url,code`;
    const res = await fetch(url);
    const json = await res.json();
    return (json.products || []).filter(p => p.product_name || p.product_name_he);
  }catch(e){
    return [];
  }
}

function renderOffNameMatches(products, introText){
  resultArea.innerHTML = `
    <div class="card">
      <h4><span class="dot"></span>התאמות אפשריות</h4>
      <p class="small" style="margin-bottom:10px;">${introText}</p>
      <div id="ilNameMatchResults"></div>
    </div>`;
  const container = document.getElementById('ilNameMatchResults');
  container.innerHTML = products.map((p, i) => `
    <div class="alt-product" style="cursor:pointer;" data-idx="${i}">
      <div>
        <div style="font-weight:600;font-size:14px;">${p.product_name_he || p.product_name}</div>
        <div class="alt-brand">${p.brands || ''}</div>
      </div>
      <span class="nutriscore ns-${(p.nutriscore_grade||'x').toLowerCase()}">${(p.nutriscore_grade||'?').toUpperCase()}</span>
    </div>`).join('');
  container.querySelectorAll('[data-idx]').forEach(el=>{
    el.addEventListener('click', async ()=>{
      const product = products[Number(el.dataset.idx)];
      const ingredientsText = product.ingredients_text_he || product.ingredients_text || '';
      if(!ingredientsText){
        setStatus('נמצא מוצר תואם, אבל אין לו רשימת רכיבים במאגר.', false);
        return;
      }
      resultArea.innerHTML = '';
      renderProductHeader(product);
      setStatus('מחפש חלופות טובות יותר...', true);
      const alternatives = await fetchAlternatives(product);
      await analyzeWithClaude({
        extractedText: buildTextForModel(product, ingredientsText),
        knownAlternatives: alternatives
      });
    });
  });
}

function buildTextForModel(product, ingredientsText){
  const n = product.nutriments || {};
  const nutriLine = `סוכר ל-100 גרם: ${n['sugars_100g'] ?? 'לא ידוע'} | נתרן ל-100 גרם: ${n['sodium_100g'] ?? 'לא ידוע'} | שומן רווי ל-100 גרם: ${n['saturated-fat_100g'] ?? 'לא ידוע'} | נוטריסקור: ${(product.nutriscore_grade||'לא ידוע').toUpperCase()}`;
  return `רכיבים: ${ingredientsText}\n${nutriLine}`;
}

function renderProductHeader(product){
  const name = product.product_name_he || product.product_name || 'מוצר ללא שם';
  const grade = (product.nutriscore_grade || 'x').toLowerCase();
  previewArea.innerHTML = `
    <div class="card product-card">
      <img class="product-img" src="${product.image_front_url || ''}" onerror="this.style.visibility='hidden'">
      <div style="flex:1;">
        <div class="product-name">${name}</div>
        <div class="product-brand">${product.brands || ''}</div>
      </div>
      <span class="nutriscore ns-${['a','b','c','d','e'].includes(grade)?grade:'x'}">${grade!=='x'?grade.toUpperCase():'?'}</span>
    </div>`;
}

async function fetchAlternatives(product){
  const category = (product.categories_tags || [])[ (product.categories_tags||[]).length - 1 ];
  if(!category) return [];
  const currentRank = { a:1,b:2,c:3,d:4,e:5 }[ (product.nutriscore_grade||'').toLowerCase() ] || 5;
  try{
    const url = `https://world.openfoodfacts.org/api/v2/search?categories_tags=${encodeURIComponent(category)}&nutriscore_grade=a,b&fields=product_name,brands,nutriscore_grade,code&page_size=8&sort_by=nutriscore_score`;
    const res = await fetch(url);
    const json = await res.json();
    const items = (json.products || [])
      .filter(p => p.code !== product.code && p.product_name)
      .filter(p => ({a:1,b:2,c:3,d:4,e:5}[(p.nutriscore_grade||'z').toLowerCase()] || 9) < currentRank)
      .slice(0,3)
      .map(p => ({
        name: p.product_name,
        brand: p.brands || '',
        grade: (p.nutriscore_grade||'').toUpperCase(),
        url: `https://world.openfoodfacts.org/product/${p.code}`
      }));
    return items;
  }catch(err){
    return [];
  }
}

function showError(msg){
  resultArea.innerHTML = `<div class="card error-card"><p>${msg}</p></div>`;
  resetBtn.style.display='block';
}

async function fetchAlternativesByText(queryText){
  if(!queryText) return [];
  try{
    const url = `https://world.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(queryText)}&search_simple=1&action=process&json=1&page_size=10&sort_by=unique_scans_n`;
    const res = await fetch(url);
    const json = await res.json();
    const items = (json.products || [])
      .filter(p => p.product_name && p.nutriscore_grade)
      .filter(p => ['a','b'].includes((p.nutriscore_grade||'').toLowerCase()))
      .slice(0,3)
      .map(p => ({
        name: p.product_name,
        brand: p.brands || '',
        grade: (p.nutriscore_grade||'').toUpperCase(),
        url: `https://world.openfoodfacts.org/product/${p.code}`
      }));
    return items;
  }catch(err){
    return [];
  }
}

/* ---------- usage stats (subscription credit model) ---------- */
let usageStats = { scans: 0, uploads: 0 };

async function loadUsageStats(){
  try{
    const res = await window.storage.get('usage_stats', false);
    usageStats = (res && res.value) ? JSON.parse(res.value) : { scans: 0, uploads: 0 };
  }catch(e){
    usageStats = { scans: 0, uploads: 0 };
  }
}

async function bumpUsage(kind){
  usageStats[kind] = (usageStats[kind] || 0) + 1;
  try{ await window.storage.set('usage_stats', JSON.stringify(usageStats), false); }catch(e){}
}

function renderSubscription(){
  const scans = usageStats.scans || 0;
  const uploads = usageStats.uploads || 0;
  const discount = (scans + uploads) * 0.001;
  const finalPrice = Math.max(0, SUBSCRIPTION_BASE_PRICE - discount);
  document.getElementById('subBasePrice').textContent = `₪${SUBSCRIPTION_BASE_PRICE.toFixed(2)} לחודש`;
  document.getElementById('subFinalPriceLine').textContent =
    `לאחר ההנחה שצברת: ₪${finalPrice.toFixed(3)} (הנחה מצטברת של ₪${discount.toFixed(3)})`;
  document.getElementById('subUsageLine').innerHTML =
    `${scans} סריקות מוצרים · ${uploads} מתכונים שהועלו לקהילה`;
}

subscriptionPill.addEventListener('click', ()=>{
  renderSubscription();
  openScreen(subscriptionOverlay);
});
closeSubscriptionBtn.addEventListener('click', ()=>{
  closeScreen(subscriptionOverlay);
});

/* ---------- shared analysis ---------- */
async function analyzeWithClaude({extractedText, knownAlternatives}){
  setStatus('מנתח מול הפרופיל שלך...', true);

  const profileDesc = [
    profile.diet && profile.diet.length ? 'סגנון תזונה: ' + profile.diet.join(', ') : null,
    profile.goals && profile.goals.length ? 'יעדים: ' + profile.goals.join(', ') : null,
    profile.allergies && profile.allergies.length ? 'רגישויות/אלרגיות: ' + profile.allergies.join(', ') : null,
  ].filter(Boolean).join(' | ') || 'לא הוגדר פרופיל מיוחד — תן הערכה כללית לתזונה מאוזנת.';

  const systemPrompt = `אתה עוזר תזונה. תענה אך ורק ב-JSON תקני, בעברית, ללא שום טקסט נוסף לפני או אחרי, וללא Markdown code fences.
המבנה חייב להיות בדיוק כך:
{
  "product_guess": "2-4 מילים לזיהוי סוג המוצר לפי הרכיבים, למשל 'דגני בוקר מתוקים' או 'רוטב עגבניות'",
  "verdict": "מומלץ" | "בסדר במידה" | "לא מומלץ",
  "score": מספר בין 1 ל-10,
  "reasoning": "הסבר קצר (2-3 משפטים) המבוסס על הרכיבים והנתונים שסופקו ועל הפרופיל שניתן, כולל התייחסות מפורשת אם המשתמש טבעוני/צמחוני/פליאו/קטוגני",
  "flags": ["רכיב או בעיה ספציפית", ...עד 4 פריטים],
  "alternative_idea": "תיאור של סוג מוצר חלופי טבעי/בריא יותר וקריטריונים לבחירתו (לא שם מותג ספציפי, אלא מה לחפש בתווית) — למלא תמיד גם אם יש חלופות אמיתיות ידועות",
  "recipe": {
    "title": "שם מתכון ביתי פשוט למוצר דומה, מותאם לסגנון התזונה של המשתמש",
    "time_and_yield": "זמן הכנה ותפוקה משוערים",
    "ingredients": ["רכיב וכמות", ...],
    "steps": ["שלב", ...]
  }
}
חובה להתאים את המתכון לסגנון התזונה שצוין בפרופיל:
- קטוגני: דל מאוד בפחמימות, ללא סוכר/קמח/דגנים, עתיר שומן איכותי וחלבון.
- פליאו: ללא דגנים, קטניות, מוצרי חלב, סוכר מזוקק או מרכיבים מעובדים — רק מרכיבים "מהטבע".
- טבעוני: ללא שום מוצר מן החי (כולל דבש, חלב, ביצים).
- צמחוני: ללא בשר ודגים, מוצרי חלב וביצים מותרים.
אם לא צוין סגנון תזונה מיוחד, הכן מתכון מאוזן רגיל.
אם הטקסט שסופק לא נראה כמו רשימת רכיבים אמיתית, עדיין נסה לתת הערכה סבירה על סמך מה שכן ניתן להבין, ואל תמציא רכיבים שלא נרמזו בטקסט.`;

  const userPrompt = `פרופיל המשתמש: ${profileDesc}

נתונים שזוהו על המוצר (ייתכנו שגיאות אם מקורם בקריאת תמונה):
"""
${extractedText}
"""

נתח את המוצר עבור המשתמש הזה.`;

  try{
    const response = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 1000,
        system: systemPrompt,
        messages: [{ role: "user", content: userPrompt }]
      })
    });
    const json = await response.json();
    const textOut = (json.content || []).map(b=>b.text||'').join('\n');
    const clean = textOut.replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(clean);

    let alternatives = knownAlternatives || [];
    if(!alternatives.length && parsed.product_guess){
      setStatus('מחפש חלופה בריאה יותר...', true);
      alternatives = await fetchAlternativesByText(parsed.product_guess);
    }

    await bumpUsage('scans');
    renderResult(parsed, extractedText, alternatives);
  }catch(err){
    setStatus('', false);
    showError('לא הצלחתי לנתח את המוצר כרגע. נסה שוב בעוד רגע.');
  }
}

function badgeClass(verdict){
  if(verdict === 'מומלץ') return 'badge-good';
  if(verdict === 'לא מומלץ') return 'badge-bad';
  return 'badge-warn';
}

function renderResult(r, rawText, knownAlternatives){
  setStatus('', false);
  const flagsHtml = (r.flags||[]).map(f=>`<span class="flag">${f}</span>`).join('');
  const ingHtml = (r.recipe && r.recipe.ingredients || []).map(i=>`<li>${i}</li>`).join('');
  const stepsHtml = (r.recipe && r.recipe.steps || []).map(s=>`<li>${s}</li>`).join('');

  const realAltHtml = (knownAlternatives||[]).map(a => `
    <div class="alt-product">
      <div>
        <a href="${a.url}" target="_blank" rel="noopener">${a.name}</a>
        <div class="alt-brand">${a.brand}</div>
      </div>
      <span class="nutriscore ns-${a.grade.toLowerCase()}">${a.grade}</span>
    </div>`).join('');

  resultArea.innerHTML = `
    ${r.product_guess ? `<p class="product-guess" style="margin-top:14px;">זיהינו: ${r.product_guess}</p>` : ''}
    <div class="card verdict-card">
      <div class="verdict-top">
        <span class="verdict-badge ${badgeClass(r.verdict)}">${r.verdict||'—'}</span>
        <span class="score">התאמה: ${r.score||'—'}/10</span>
      </div>
      <p class="reasoning">${r.reasoning||''}</p>
      <div class="flags">${flagsHtml}</div>
    </div>

    <div class="card">
      <h4><span class="dot"></span>חלופה טבעית יותר</h4>
      ${realAltHtml ? `<p class="small">מוצרים אמיתיים ממאגר Open Food Facts עם נוטריסקור טוב יותר באותה קטגוריה:</p>${realAltHtml}` : ''}
      <p style="${realAltHtml?'margin-top:12px;':''}">${r.alternative_idea||'אין מספיק מידע להצעת חלופה.'}</p>
    </div>

    <div class="card">
      <h4><span class="dot"></span>${r.recipe && r.recipe.title || 'מתכון ביתי'}</h4>
      <p class="recipe-meta">${r.recipe && r.recipe.time_and_yield || ''}</p>
      <ul class="recipe-list">${ingHtml}</ul>
      <ol class="recipe-steps">${stepsHtml}</ol>
      <button class="save-recipe-btn" id="saveRecipeBtn">שמור מתכון לספר שלי</button>
    </div>

    <details class="raw">
      <summary>הנתונים הגולמיים שנשלחו לניתוח</summary>
      <pre>${rawText}</pre>
    </details>
  `;
  resetBtn.style.display='block';

  const saveRecipeBtn = document.getElementById('saveRecipeBtn');
  if(saveRecipeBtn){
    saveRecipeBtn.addEventListener('click', ()=> saveRecipeToBook(r, saveRecipeBtn));
  }
}

document.querySelectorAll('.bn-item').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.bn-item').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const target = btn.dataset.target;
    if(target === 'scan'){
      closeAllScreens();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if(target === 'cookbook'){
      cookbookPill.click();
    } else if(target === 'community'){
      communityPill.click();
    } else if(target === 'profile'){
      profilePill.click();
    }
  });
});

document.getElementById('startAppBtn').addEventListener('click', ()=>{
  document.getElementById('landingScreen').style.display = 'none';
  document.getElementById('mainScreen').style.display = 'block';
  if(pendingOnboarding){
    pendingOnboarding = false;
    openOnboarding();
  }
});

loadProfile();
loadCookbook();
loadUsageStats();
</script>
</body>
</html>
