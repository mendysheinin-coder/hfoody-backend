];
function activateRecipeTab(activeBtn){
  recipeTabs.forEach(({btn, pane})=>{
    const isActive = btn === activeBtn;
    btn.classList.toggle('active', isActive);
    pane.style.display = isActive ? 'block' : 'none';
  });
}
